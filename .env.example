# Slide Remote — environment variables (all optional).
# Copy to .env and adjust as needed; .env is git-ignored.

# HTTP + WebSocket port the laptop server listens on.
PORT=3000

# Network interface to bind. 0.0.0.0 exposes the remote to the local network.
HOST=0.0.0.0

# Vite dev server port, accepted as a WebSocket origin during `npm run dev`.
FRONTEND_DEV_PORT=5173

# Fixed pairing PIN. Leave unset to generate a random 4-digit PIN on each start.
# CONTROL_PIN=1234

# Set to 1 to validate commands without pressing real keyboard keys.
# DRY_RUN_KEYS=1
